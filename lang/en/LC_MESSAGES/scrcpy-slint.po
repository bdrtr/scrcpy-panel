msgid "PROFİL"
msgstr "PROFILE"

msgid "Ekran yansıtılıyor"
msgstr "Mirroring the screen"

msgid "Hata · cihaz"
msgstr "Error · device"

msgid "Cihaz bulunamadı"
msgstr "No device found"

msgid "USB kablosunu takın ve cihazdaki USB hata ayıklama istemini onaylayın. Kablosuz bir cihazı Cihazlar sekmesindeki TCP/IP alanından bağlayın."
msgstr "Plug the USB cable in and confirm the USB debugging prompt on the device. Connect a wireless device from the TCP/IP field in the Devices tab."

msgid "Birden fazla cihaz bağlı"
msgstr "More than one device is connected"

msgid "Hangisinin yansıtılacağı belirsiz. Cihazlar sekmesinden birini işaretleyin."
msgstr "It is not clear which one to mirror. Tick one in the Devices tab."

msgid "Hata · yetki"
msgstr "Error · authorisation"

msgid "Cihaz yetkilendirilmemiş"
msgstr "The device is not authorised"

msgid "Cihaz ekranındaki \"Bu bilgisayara izin ver\" istemini onaylayın. İstem çıkmıyorsa USB hata ayıklamayı kapatıp açın."
msgstr "Confirm the \"Allow this computer\" prompt on the device. If no prompt appears, turn USB debugging off and on again."

msgid "Hata · bağlantı"
msgstr "Error · connection"

msgid "Cihaz çevrimdışı"
msgstr "The device is offline"

msgid "Bağlantı koptu. Kabloyu ve USB kipini denetleyin; kablosuz bir cihazda yeniden bağlanmak gerekebilir."
msgstr "The connection dropped. Check the cable and the USB mode; a wireless device may need connecting again."

msgid "Hata · sürüm"
msgstr "Error · version"

msgid "scrcpy sürümü uyumsuz"
msgstr "The scrcpy versions do not match"

msgid "Cihazdaki sunucu ile istemci aynı sürüm olmalı. Ayarlar'dan bu istemcinin beklediği sürümde bir scrcpy-server seçin."
msgstr "The server on the device and the client must be the same version. Choose a scrcpy-server of the version this client expects, from Settings."

msgid "Hata · kodlayıcı"
msgstr "Error · encoder"

msgid "Kodlayıcı bulunamadı"
msgstr "The encoder was not found"

msgid "Seçilen kodlayıcı bu cihazda yok. Cihazın listesinden birini seçin ya da kodlayıcı alanını boş bırakın."
msgstr "The chosen encoder does not exist on this device. Pick one from the device's own list, or leave the encoder field empty."

msgid "Uyarı · ses"
msgstr "Warning · audio"

msgid "Ses aktarılamıyor"
msgstr "Audio cannot be forwarded"

msgid "Ses aktarımı Android 11 ve üstünü gerektirir, ve bazı cihazlar yakalamayı engeller. Sesi kapatıp yansıtmayı sürdürebilirsiniz."
msgstr "Audio forwarding needs Android 11 or newer, and some devices block capture outright. You can turn audio off and carry on mirroring."

msgid "Hata · kayıt"
msgstr "Error · recording"

msgid "Dosya yazılamıyor"
msgstr "The file cannot be written"

msgid "Hedef klasör yazılabilir olmalı. Ayarlar'daki kayıt klasörünü değiştirin ya da izinleri düzeltin."
msgstr "The target folder has to be writable. Change the recording folder in Settings, or fix its permissions."

msgid "Hata · port"
msgstr "Error · port"

msgid "Port kullanımda"
msgstr "The port is in use"

msgid "Bu aralıktaki portlar başka bir program tarafından tutuluyor. Başka bir scrcpy açıksa kapatın ya da port aralığını değiştirin."
msgstr "The ports in this range are held by another program. Close any other scrcpy, or change the port range."

msgid "Hata · adb"
msgstr "Error · adb"

msgid "adb sunucusu çalışmıyor"
msgstr "The adb server is not running"

msgid "Cihazlara adb sunucusu üzerinden ulaşılıyor ve şu an cevap vermiyor."
msgstr "Devices are reached through the adb server, and it is not answering."

msgid "adb çalıştırılamadı. Ayarlar'dan tam yolunu verin ya da platform-tools paketini kurun."
msgstr "adb could not be run. Give its full path in Settings, or install the platform-tools package."

msgid "İşlem başarısız"
msgstr "The operation failed"

msgid "Ayrıntı aşağıdaki çıktıda. Günlük sekmesinde daha fazlası olabilir."
msgstr "The detail is in the output below. The Log tab may have more."

msgid "adb sunucusunu yeniden başlat"
msgstr "Restart the adb server"

msgid "adb yolunu seç"
msgstr "Choose the adb path"

msgid "Kodlayıcıları listele"
msgstr "List the encoders"

msgid "Ayarları aç"
msgstr "Open Settings"

msgid "Oturumu kapat"
msgstr "Close the session"

