# English translation of the scrcpy-slint panel.
#
# The source language is Turkish, so msgid is the Turkish string. Anything not
# listed here falls back to it, which is what technical values (h264, 8M,
# /dev/video0) and the program's own name want anyway.
#
# Both halves of the program read this file: slint-build bundles it for the
# @tr() strings in ui/, and build.rs turns it into a table for the messages
# built in Rust.
msgid ""
msgstr ""
"Project-Id-Version: scrcpy-slint\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: en\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

