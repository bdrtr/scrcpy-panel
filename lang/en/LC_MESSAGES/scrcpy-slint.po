msgid "Cihazı döndür"
msgstr "Rotate the device"

msgid "Bildirim panelini aç / kapat"
msgstr "Expand / collapse the notification panel"

msgid "Panoyu kopyala / kes"
msgstr "Copy / cut to the computer"

msgid "Panoyu yapıştır / yazdır"
msgstr "Paste the clipboard / type it"

msgid "Klavye ayarlarını aç"
msgstr "Open the keyboard settings"

msgid "Kamera fenerini yak / söndür"
msgstr "Camera torch on / off"

msgid "Merkez etrafında yakınlaştır ve döndür"
msgstr "Pinch and rotate about the centre"

msgid "İki parmakla yukarı aşağı kaydır"
