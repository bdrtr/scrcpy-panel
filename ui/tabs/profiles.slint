// Tab · Profiller
//
// A saved profile is a complete flag set, not a delta: applying one rewrites
// every field in the Yapılandırma tab. The list itself lives in Rust — the
// panel only renders App.profiles and fires the three callbacks back.
//
// The mockup lays the cards out in a three-column CSS grid. Slint's GridLayout
// takes static `Row { }` children, so it cannot be driven by a `for` over a
// dynamic model. Three columns side by side do the same job: each one walks the
// whole model and keeps every third card, the way a grid fills row by row.
//
// A `for` cannot skip an item in Slint, so the cards that belong to another
// column stay as empty wrappers. That is why the columns carry no spacing —
// spacing would be inserted between the empty ones too, and the columns would
// drift apart. The 2px gaps are drawn by the cards themselves over a divider
// background, which is what gives the mockup its hairline grid.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App } from "../state.slint";
import { Kicker, SectionHead, Hr, Btn, Mono } from "../components.slint";

export component TabProfiles inherits VerticalLayout {
    padding: Theme.s6;
    spacing: Theme.s4;

    // ── Header: heading on the left, save action on the right ────────
    HorizontalLayout {
        spacing: Theme.s4;

        SectionHead {
            horizontal-stretch: 1;
            kicker: @tr("Kayıtlı yapılandırmalar");
            title: @tr("Profiller");
            desc: @tr("Her profil tam bir bayrak kümesidir. Bir profili uygulamak Yapılandırma sekmesindeki tüm alanları yeniden yazar; cihaza sabitlenen profiller o cihaz bağlandığında öntanımlı olur.");
        }

        // `align-items: flex-end` in the mockup — the button sits on the
        // baseline of the description, not in the middle of the block.
        VerticalLayout {
            alignment: end;
            horizontal-stretch: 0;
            Btn {
                text: @tr("Geçerli ayarları kaydet");
                kind: "primary";
                clicked => { App.save-profile(); }
            }
        }
    }

    Hr {}

    // ── The cards ────────────────────────────────────────────────────
    ScrollView {
        vertical-stretch: 1;
        // Keep the long monospace flag lines from forcing a horizontal
        // scrollbar; they wrap inside the card instead.
        viewport-width: self.visible-width;

        VerticalLayout {
            // The ground below is as tall as it is given unless something says
            // otherwise, and what it is given is the whole viewport. In CSS a
            // grid with nothing in it has no height at all, which is why the
            // mockup can paint the same colour behind the same cards; here it
            // painted the entire tab divider-grey on a fresh install, with no
            // cards and nothing else to see. It takes its own height now.
            alignment: start;

            // ── Boş durum ────────────────────────────────────────────────
            //
            // The mockup has no empty state for this tab — it is drawn with six
            // profiles in it and never without — but a fresh install has none, and
            // the Devices tab already has a card for exactly this case.
            if App.profiles.length == 0: Rectangle {
                border-width: 2px;
                border-color: Theme.divider;

                VerticalLayout {
                    padding: Theme.s8;
                    spacing: Theme.s3;
                    alignment: start;

                    HorizontalLayout {
                        alignment: start;
                        Kicker { text: @tr("Boş durum").to-uppercase(); }
                    }

                    Text {
                        text: @tr("Kayıtlı profil yok");
                        font-family: Theme.font;
                        font-size: 22px;
                        font-weight: Theme.heading-weight;
                        color: Theme.text;
                    }

                    Text {
                        text: @tr("Yapılandırma sekmesinde bir bayrak kümesi hazırlayın ve yukarıdaki düğmeyle buraya kaydedin. Bir profili uygulamak o kümenin tamamını geri yükler.");
                        font-size: 13px;
                        color: Theme.neutral-700;
                        wrap: word-wrap;
                    }
                }
            }

            // The ground the 2px gaps show through.
            if App.profiles.length > 0: Rectangle {
                background: Theme.divider;

                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;

                    for col in [0, 1, 2]: VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;

                        for p[i] in App.profiles: slot := VerticalLayout {
                            property <bool> mine: Math.mod(i, 3) == col;
                            // Nothing of another column's card is laid out.
                            vertical-stretch: 0;

                            if slot.mine: VerticalLayout {
                                Rectangle {
                                    background: Theme.bg;

                                    VerticalLayout {
                                        padding: Theme.s4;
                                        spacing: Theme.s2;

                                        Kicker { text: p.kicker.to-uppercase(); }

                                        Text {
                                            text: p.name;
                                            font-family: Theme.font;
                                            font-size: 17px;
                                            font-weight: Theme.heading-weight;
                                            color: Theme.text;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: p.desc;
                                            font-size: 13px;
                                            color: Theme.text-70;
                                            wrap: word-wrap;
                                        }

                                        Mono {
                                            text: p.flags;
                                            font-size: 11px;
                                            color: Theme.neutral-700;
                                            wrap: word-wrap;
                                        }

                                        // `border-top` on the action row in the mockup.
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.divider;
                                        }

                                        HorizontalLayout {
                                            spacing: Theme.s2;

                                            Btn {
                                                text: @tr("Uygula");
                                                kind: "ghost";
                                                clicked => { App.apply-profile(i); }
                                            }
                                            Btn {
                                                text: @tr("Düzenle");
                                                kind: "ghost";
                                                clicked => { App.edit-profile(i); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Btn {
                                                text: @tr("Sil");
                                                kind: "ghost";
                                                clicked => { App.delete-profile(i); }
                                            }
                                        }
                                    }
                                }
                                // The gap below the card, in the grid's colour.
                                Rectangle { height: 2px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
