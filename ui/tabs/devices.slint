// Tab · Cihazlar
//
// The mockup drives this tab with a "Önizleme durumu" segment (Liste / Boş /
// Hata) so the three states can be inspected side by side. The real panel has
// no such switch: the state falls out of the data. The list is rendered when
// App.devices is non-empty, the empty card when it is empty and there is no
// error, and the error card whenever App.device-error is set — so a partial
// listing plus a warning shows both, which is what adb actually reports. The
// wireless grid sits below whichever card is showing and is never gated: the
// empty state's "TCP/IP ile bağlan" button needs its address field on screen.
//
// The TCP/IP address is the same value as section 08's --tcpip field, so it
// binds Cfg.tcpip-addr and fires `changed()`. The pairing fields are panel
// state (App), not scrcpy flags, and Rust reads them when the matching
// callback fires.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App, Cfg } from "../state.slint";
import { Kicker, SectionHead, Hr, Fld, Inp, Chk, Btn, Tag, Mono } from "../components.slint";

// The table's measurements, in one place.
//
// The eight column widths were written out twice, in the header and in the row,
// under a comment saying the two copies must stay in step — and their sum is a
// third thing that has to agree with them, because it is the width the table
// has to be able to scroll to. The two heights are the same story: the scroller
// around the table has to be told how tall the table is.
global Table {
    out property <length> check: 34px;
    out property <length> name: 150px;  // the stretchy column's floor
    out property <length> serial: 170px;
    out property <length> conn: 90px;
    out property <length> android: 80px;
    out property <length> screen: 100px;
    out property <length> state: 90px;
    out property <length> action: 90px;

    out property <length> head: 34px;
    out property <length> row: 42px;
    /// What a ScrollView's own horizontal bar takes off the bottom.
    out property <length> bar: 14px;

    // Eight cells, seven gaps and the padding either side.
    out property <length> total:
        Table.check + Table.name + Table.serial + Table.conn + Table.android
        + Table.screen + Table.state + Table.action + 7 * Theme.s4 + 2 * Theme.s2;
}

// `.table th` — 11px, uppercase, 0.08em tracking, over a 2px rule.
component Th inherits Text {
    font-family: Theme.font;
    font-size: 11px;
    letter-spacing: 0.88px;
    color: Theme.text-60;
    vertical-alignment: center;
    overflow: elide;
}

// `.table td` — plain 14px body text over a 1px rule.
component Td inherits Text {
    font-size: 14px;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

export component TabDevices inherits VerticalLayout {
    padding: Theme.s6;
    spacing: Theme.s4;

    SectionHead {
        kicker: @tr("Bağlı donanım");
        title: @tr("Cihazlar");
        desc: @tr("USB ve kablosuz cihazlar adb devices -l ile listelenir. Birden fazla cihaz seçilebilir; aynı yapılandırma hepsinde aynı anda başlatılır ve alt şeritteki komut bir döngüye dönüşür.");
    }

    Hr {}

    ScrollView {
        vertical-stretch: 1;
        // Long serials and error output must wrap rather than push a
        // horizontal scrollbar under the tab. The table is the one thing here
        // that cannot wrap, and it has a scroller of its own below.
        viewport-width: self.visible-width;

        VerticalLayout {
            spacing: Theme.s4;
            alignment: start;

            // ── Liste ────────────────────────────────────────────────
            //
            // The table gets a scroller of its own rather than widening the
            // tab. Seven of its eight columns are a fixed number of pixels, so
            // below Table.total there is no layout for it and the last column —
            // the one with the button that starts a mirror — is sheared off the
            // edge with no way to reach it. Widening the whole tab instead was
            // tried and is worse: it takes the wireless panels beside it, which
            // wrap perfectly well, off the edge too.
            //
            // The height is the table's own, since a ScrollView would otherwise
            // take whatever it is given, plus room for the bar on the widths
            // where there is one.
            if App.devices.length > 0: ScrollView {
                height: Table.head + App.devices.length * Table.row
                    + (self.visible-width < Table.total ? Table.bar : 0px);
                viewport-width: max(self.visible-width, Table.total);
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0;

                    Rectangle {
                        height: Table.head;

                        HorizontalLayout {
                            padding-left: Theme.s2;
                            padding-right: Theme.s2;
                            spacing: Theme.s4;

                            Rectangle { width: Table.check; }
                            Th {
                                text: @tr("CİHAZ");
                                horizontal-stretch: 1;
                                min-width: Table.name;
                            }
                            Th { text: @tr("SERİ NO"); width: Table.serial; }
                            Th { text: @tr("BAĞLANTI"); width: Table.conn; }
                            Th { text: @tr("ANDROID"); width: Table.android; }
                            Th { text: @tr("EKRAN"); width: Table.screen; }
                            Th { text: @tr("DURUM"); width: Table.state; }
                            Th {
                                text: @tr("İŞLEM");
                                width: Table.action;
                                horizontal-alignment: right;
                            }
                        }

                        Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: Theme.divider;
                        }
                    }

                    for d[i] in App.devices: Rectangle {
                        height: Table.row;
                        background: row-touch.has-hover ? Theme.wash-4 : transparent;

                        row-touch := TouchArea {}

                        HorizontalLayout {
                            padding-left: Theme.s2;
                            padding-right: Theme.s2;
                            spacing: Theme.s4;

                            Rectangle {
                                width: Table.check;
                                // Rust owns the selection: it toggles the row in
                                // App.devices and pushes the model back, so the box
                                // shows what is actually selected.
                                Chk {
                                    y: (parent.height - self.height) / 2;
                                    checked: d.selected;
                                    toggled => {
                                        App.select-device(d.serial);
                                        self.checked = d.selected;
                                    }
                                }
                            }
                            Td {
                                text: d.name;
                                font-weight: 600;
                                horizontal-stretch: 1;
                                min-width: Table.name;
                            }
                            Mono {
                                text: d.serial;
                                width: Table.serial;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Td { text: d.conn; width: Table.conn; }
                            Td { text: d.android; width: Table.android; }
                            Mono {
                                text: d.screen;
                                width: Table.screen;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: Table.state;
                                Tag {
                                    y: (parent.height - self.height) / 2;
                                    text: d.state;
                                    kind: "neutral";
                                }
                            }
                            Rectangle {
                                width: Table.action;
                                Btn {
                                    x: parent.width - self.width;
                                    y: (parent.height - self.height) / 2;
                                    width: self.min-width;
                                    text: @tr("Aynala");
                                    kind: "ghost";
                                    clicked => { App.mirror-device(d.serial); }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                }
            }

            // ── Boş durum ────────────────────────────────────────────
            if App.devices.length == 0 && App.device-error == "": Rectangle {
                border-width: 2px;
                border-color: Theme.divider;

                VerticalLayout {
                    padding: Theme.s8;
                    spacing: Theme.s3;
                    alignment: start;

                    HorizontalLayout {
                        alignment: start;
                        Kicker { text: @tr("Boş durum").to-uppercase(); }
                    }

                    Text {
                        text: @tr("Bağlı cihaz yok");
                        font-family: Theme.font;
                        font-size: 22px;
                        font-weight: Theme.heading-weight;
                        color: Theme.text;
                    }

                    Text {
                        text: @tr("USB kablosunu takın ve cihazda USB hata ayıklamayı onaylayın. Kablosuz bir cihaz için aşağıdan adres girin.");
                        font-size: 13px;
                        color: Theme.neutral-700;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        padding-top: Theme.s2;
                        spacing: Theme.s2;
                        alignment: start;

                        Btn {
                            text: @tr("Yeniden tara");
                            kind: "primary";
                            clicked => { App.refresh-devices(); }
                        }
                        Btn {
                            text: @tr("TCP/IP ile bağlan");
                            kind: "secondary";
                            clicked => { App.tcpip-connect(); }
                        }
                        // In the mockup only; there is no help view to open
                        // yet, so it is drawn disabled rather than inert.
                        Btn {
                            text: @tr("Kurulum yardımı");
                            kind: "ghost";
                            enabled: false;
                        }
                    }
                }
            }

            // ── Hata ─────────────────────────────────────────────────
            if App.device-error != "": Rectangle {
                background: Theme.accent-100;
                border-width: 2px;
                border-color: Theme.accent;

                VerticalLayout {
                    padding: Theme.s8;
                    spacing: Theme.s3;
                    alignment: start;

                    HorizontalLayout {
                        alignment: start;
                        Kicker { text: App.device-error-tag.to-uppercase(); }
                    }

                    Text {
                        text: App.device-error-title;
                        font-family: Theme.font;
                        font-size: 22px;
                        font-weight: Theme.heading-weight;
                        color: Theme.accent-800;
                    }

                    Text {
                        text: App.device-error-detail;
                        font-size: 13px;
                        color: Theme.accent-800;
                        wrap: word-wrap;
                    }

                    // The mockup prints the failing command and its output in a
                    // dark monospace block; App.device-error carries both.
                    Rectangle {
                        background: Theme.neutral-900;

                        VerticalLayout {
                            padding: Theme.s3;
                            Mono {
                                text: App.device-error;
                                color: Theme.neutral-200;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-top: Theme.s2;
                        spacing: Theme.s2;
                        alignment: start;

                        Btn {
                            text: @tr("Yeniden tara");
                            kind: "primary";
                            clicked => { App.refresh-devices(); }
                        }
                        // The second action depends on the failure; with
                        // nothing useful to offer there is no button.
                        if App.device-error-action != "": Btn {
                            text: App.device-error-action;
                            kind: "secondary";
                            clicked => { App.device-remedy(); }
                        }
                        Btn {
                            text: @tr("Günlüğü aç");
                            kind: "ghost";
                            clicked => { App.tab = "log"; }
                        }
                    }
                }
            }

            // `margin-top: var(--space-8)` on the wireless grid; the outer
            // layout already contributes s4 of spacing above it.
            HorizontalLayout {
                padding-top: Theme.s4;
                spacing: Theme.s6;

                // ── Kablosuz ─────────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    alignment: start;

                    Kicker { text: @tr("Kablosuz").to-uppercase(); }

                    // `margin: 6px 0 var(--space-3)` on the h3.
                    Rectangle { height: 6px; }
                    Text {
                        text: @tr("TCP/IP ile bağlan");
                        font-family: Theme.font;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Rectangle { height: Theme.s3; }

                    HorizontalLayout {
                        spacing: Theme.s2;

                        Fld {
                            horizontal-stretch: 1;
                            label: @tr("Adres:port (--tcpip)");
                            Inp {
                                // Section 08 binds the same value: one
                                // field, one --tcpip flag.
                                text <=> Cfg.tcpip-addr;
                                placeholder: "192.168.1.42:5555";
                                mono: true;
                                edited => { Cfg.changed(); }
                            }
                        }
                        // `align-items: flex-end` — the button sits on the
                        // bottom edge of the input, not of the label.
                        VerticalLayout {
                            alignment: end;
                            horizontal-stretch: 0;
                            Btn {
                                text: @tr("Bağlan");
                                kind: "secondary";
                                height: 36px;
                                clicked => { App.tcpip-connect(); }
                            }
                        }
                    }

                    Rectangle { height: Theme.s2; }
                    Text {
                        text: @tr("USB'den geçiş için adb tcpip 5555 otomatik çalıştırılır.");
                        font-size: 12px;
                        color: Theme.neutral-700;
                        wrap: word-wrap;
                    }
                }

                // ── Android 11+ ──────────────────────────────────────
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    alignment: start;

                    Kicker { text: @tr("Android 11+").to-uppercase(); }

                    Rectangle { height: 6px; }
                    Text {
                        text: @tr("Kablosuz eşleştirme");
                        font-family: Theme.font;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Rectangle { height: Theme.s3; }

                    HorizontalLayout {
                        spacing: Theme.s2;

                        Fld {
                            horizontal-stretch: 1;
                            label: @tr("Eşleştirme adresi");
                            Inp {
                                text <=> App.pair-addr;
                                placeholder: "192.168.1.42:37105";
                                mono: true;
                            }
                        }
                        Fld {
                            width: 110px;
                            horizontal-stretch: 0;
                            label: @tr("Kod");
                            Inp {
                                text <=> App.pair-code;
                                placeholder: "482913";
                                mono: true;
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            horizontal-stretch: 0;
                            Btn {
                                text: @tr("Eşleştir");
                                kind: "secondary";
                                height: 36px;
                                clicked => { App.pair-device(); }
                            }
                        }
                    }

                    Rectangle { height: Theme.s2; }
                    Text {
                        text: @tr("Geliştirici seçenekleri → Kablosuz hata ayıklama → Cihazı kodla eşleştir.");
                        font-size: 12px;
                        color: Theme.neutral-700;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
