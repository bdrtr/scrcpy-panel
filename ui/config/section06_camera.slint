// Configuration · Bölüm 06 — Kamera
//
// Camera capture replaces the display as the video source. Field order, labels
// and placeholders come from design/mockup, and every control writes straight
// into Cfg and then calls Cfg.changed() so the command bar recomputes. The
// camera list button is the one control that goes back to Rust instead.

import { Theme } from "../theme.slint";
import { Cfg, App } from "../state.slint";
import { SectionHead, Hr, Fld, Grp, ChkGrp, Inp, Seg, Chk, Btn } from "../components.slint";

export component SectionCamera inherits VerticalLayout {
    spacing: Theme.s4;

    SectionHead {
        kicker: "Bölüm 06";
        title: "Kamera";
        desc: "Kamera aktarımı Android 12+ gerektirir ve video kaynağı olarak ekranın yerine geçer. Boyut yerine en-boy oranı verilirse cihaz en yakın desteklenen çözünürlüğü seçer.";
    }

    Hr {}

    Grp {
        Row {
            Fld {
                label: "Yön · --camera-facing";
                Seg {
                    labels: ["arka", "ön", "harici"];
                    values: ["back", "front", "external"];
                    value <=> Cfg.camera-facing;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: "Kamera no · --camera-id";
                Inp {
                    text <=> Cfg.camera-id;
                    placeholder: "0";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: "Boyut · --camera-size";
                Inp {
                    text <=> Cfg.camera-size;
                    placeholder: "1920x1080";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
        Row {
            Fld {
                label: "En-boy oranı · --camera-ar";
                Inp {
                    text <=> Cfg.camera-ar;
                    placeholder: "16:9";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: "Kare hızı · --camera-fps";
                Inp {
                    text <=> Cfg.camera-fps;
                    placeholder: "60";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            // The button sits in the third column with a label above it, so it
            // lines up with the inputs; hence the 36px height instead of 34px.
            Fld {
                label: "Kamera listesi";
                Btn {
                    text: "Cihazdan seç · --list-cameras";
                    height: 36px;
                    block: true;
                    clicked => { App.list-cameras(); }
                }
            }
        }
    }

    Hr {}

    ChkGrp {
        Row {
            Chk {
                text: "Yüksek hız kipi · --camera-high-speed";
                checked <=> Cfg.camera-high-speed;
                toggled => { Cfg.changed(); }
            }
            Rectangle {}
        }
    }

    Rectangle { vertical-stretch: 1; }
}
