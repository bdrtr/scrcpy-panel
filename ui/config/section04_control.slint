// Configuration · Bölüm 04 — Kontrol ve giriş
//
// Klavye, fare ve kumanda arayüzleri. Her denetim doğrudan Cfg'ye yazar ve
// ardından Cfg.changed() çağırır, böylece komut çubuğu yeniden hesaplanır.
// Yapı, alan sırası ve etiketler design/mockup'tan birebir alınmıştır.

import { Theme } from "../theme.slint";
import { Cfg } from "../state.slint";
import { SectionHead, Hr, Fld, Grp, ChkGrp, Inp, Seg, Sel, Chk } from "../components.slint";

export component SectionControl inherits VerticalLayout {
    spacing: Theme.s4;

    SectionHead {
        kicker: @tr("Bölüm 04");
        title: @tr("Kontrol ve giriş");
        desc: @tr("UHID modu cihazda fiziksel klavye gibi görünür ve düzeni bilgisayardan alır. AOA yalnızca USB üzerinde çalışır; OTG modunda video hiç aktarılmaz.");
    }

    Hr {}

    Grp {
        Row {
            Fld {
                label: @tr("Klavye · --keyboard");
                Seg {
                    labels: [@tr("sdk"), @tr("uhid"), @tr("aoa"), @tr("kapalı")];
                    values: ["sdk", "uhid", "aoa", "disabled"];
                    value <=> Cfg.keyboard;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Fare · --mouse");
                Seg {
                    labels: [@tr("sdk"), @tr("uhid"), @tr("aoa"), @tr("kapalı")];
                    values: ["sdk", "uhid", "aoa", "disabled"];
                    value <=> Cfg.mouse;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Oyun kumandası · --gamepad");
                Seg {
                    labels: [@tr("kapalı"), @tr("uhid"), @tr("aoa")];
                    values: ["disabled", "uhid", "aoa"];
                    value <=> Cfg.gamepad;
                    changed => { Cfg.changed(); }
                }
            }
        }
        Row {
            Fld {
                label: @tr("Kısayol tuşu · --shortcut-mod");
                Sel {
                    labels: [@tr("Sol Alt"), @tr("Sol Super"), @tr("Sağ Ctrl"), @tr("Sol Ctrl + Sol Alt")];
                    values: ["lalt", "lsuper", "rctrl", "lctrl+lalt"];
                    value <=> Cfg.shortcut-mod;
                    changed => { Cfg.changed(); }
                }
            }
            // Both of these are disabled rather than removed: the mockup has
            // them, but nothing reads them yet. An enabled control that does
            // nothing is worse than one that says it does nothing.
            Fld {
                label: @tr("Klavye düzeni — UHID gelince");
                Inp {
                    text <=> Cfg.key-layout;
                    placeholder: @tr("UHID henüz yok");
                    mono: true;
                    enabled: false;
                }
            }
            Fld {
                label: @tr("Pano yönü — henüz yok");
                Sel {
                    labels: [@tr("İki yönlü"), @tr("Yalnızca cihaza"), @tr("Yalnızca bilgisayara")];
                    values: ["both", "toDevice", "toPc"];
                    value <=> Cfg.clipboard-direction;
                }
            }
        }
    }

    Hr {}

    ChkGrp {
        Row {
            Chk {
                text: @tr("OTG modu · --otg (video yok, yalnızca giriş)");
                checked <=> Cfg.otg;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Salt izleme · --no-control");
                checked <=> Cfg.no-control;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Pano eşitlemesini kapat · --no-clipboard-autosync");
                checked <=> Cfg.no-clipboard-autosync;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Tüm fare tuşlarını ilet · --forward-all-clicks");
                checked <=> Cfg.forward-all-clicks;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Eski yapıştırma · --legacy-paste");
                checked <=> Cfg.legacy-paste;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Metin olayını yeğle · --prefer-text");
                checked <=> Cfg.prefer-text;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Ham tuş olayları · --raw-key-events");
                checked <=> Cfg.raw-key-events;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Fare tuşu eşlemesi · --mouse-bind=++++");
                checked <=> Cfg.mouse-bind-enabled;
                toggled => { Cfg.changed(); }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
