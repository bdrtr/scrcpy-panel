// Configuration · Bölüm 08 — Ağ ve ADB
//
// The connection half of the flag set: which device to talk to, which local
// ports to use, and how much the server logs. Panel-side adb settings (the adb
// binary, its port) live in the Ayarlar tab, not here.

import { Theme } from "../theme.slint";
import { Cfg } from "../state.slint";
import { SectionHead, Hr, Fld, Grp, ChkGrp, Inp, Sel, Chk } from "../components.slint";

export component SectionNetwork inherits VerticalLayout {
    spacing: Theme.s4;

    SectionHead {
        kicker: @tr("Bölüm 08");
        title: @tr("Ağ ve ADB");
        desc: @tr("Yerel port yönlendirme varsayılan yoldur. Uzak bir adb sunucusuna bağlanırken tünel konağı ve portu birlikte verilmelidir.");
    }

    Hr {}

    Grp {
        Row {
            Fld {
                label: @tr("Hedef seri no · --serial");
                Inp {
                    text <=> Cfg.serial;
                    placeholder: @tr("R58M31XABCD");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Yerel port aralığı · --port");
                Inp {
                    text <=> Cfg.port;
                    placeholder: "27183";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("TCP/IP adresi · --tcpip");
                Inp {
                    text <=> Cfg.tcpip-addr;
                    placeholder: "192.168.1.42:5555";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
        Row {
            Fld {
                label: @tr("Tünel konağı · --tunnel-host");
                Inp {
                    text <=> Cfg.tunnel-host;
                    placeholder: "192.168.1.42";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Tünel portu · --tunnel-port");
                Inp {
                    text <=> Cfg.tunnel-port;
                    placeholder: "1234";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Sunucu günlük düzeyi · --verbosity");
                Sel {
                    labels: [@tr("debug"), @tr("info"), @tr("warn"), @tr("error")];
                    value <=> Cfg.verbosity;
                    changed => { Cfg.changed(); }
                }
            }
        }
    }

    Hr {}

    ChkGrp {
        Row {
            Chk {
                text: @tr("Kablosuz bağlan · --tcpip");
                checked <=> Cfg.tcpip-enabled;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Yönlendirmeyi zorla · --force-adb-forward");
                checked <=> Cfg.force-adb-forward;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Yalnızca USB · --select-usb");
                checked <=> Cfg.select-usb;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Yalnızca TCP/IP · --select-tcpip");
                checked <=> Cfg.select-tcpip;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Çıkışta adb'yi durdur · --kill-adb-on-close");
                checked <=> Cfg.kill-adb-on-close;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Temizlik yapma · --no-cleanup");
                checked <=> Cfg.no-cleanup;
                toggled => { Cfg.changed(); }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
