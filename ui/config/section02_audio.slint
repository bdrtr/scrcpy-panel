// Configuration · Bölüm 02 — Ses
//
// Audio capture and playback. Field order, labels and placeholders come from
// design/mockup, and every control writes straight into Cfg and then calls
// Cfg.changed() so the command bar recomputes.

import { Theme } from "../theme.slint";
import { Cfg } from "../state.slint";
import { SectionHead, Hr, Fld, Grp, ChkGrp, Inp, Seg, Sel, Chk } from "../components.slint";

export component SectionAudio inherits VerticalLayout {
    spacing: Theme.s4;

    SectionHead {
        kicker: @tr("Bölüm 02");
        title: @tr("Ses");
        desc: @tr("Ses aktarımı Android 11 ve üzerini gerektirir. Mikrofon kaynakları çağrı ve ses tanıma senaryolarında ayrı ayrı seçilebilir.");
    }

    Hr {}

    Grp {
        Row {
            Fld {
                label: @tr("Kodek · --audio-codec");
                Seg {
                    labels: [@tr("opus"), @tr("aac"), @tr("flac"), @tr("raw")];
                    value <=> Cfg.audio-codec;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Kaynak · --audio-source");
                Sel {
                    labels: [
                        @tr("output — cihaz çıkışı"),
                        @tr("playback — uygulama sesi"),
                        @tr("mic — mikrofon"),
                        @tr("mic-unprocessed"),
                        @tr("mic-camcorder"),
                        @tr("mic-voice-recognition"),
                        @tr("mic-voice-communication"),
                        @tr("voice-call"),
                        @tr("voice-call-uplink"),
                        @tr("voice-call-downlink"),
                        @tr("voice-performance"),
                    ];
                    values: [
                        "output",
                        "playback",
                        "mic",
                        "mic-unprocessed",
                        "mic-camcorder",
                        "mic-voice-recognition",
                        "mic-voice-communication",
                        "voice-call",
                        "voice-call-uplink",
                        "voice-call-downlink",
                        "voice-performance",
                    ];
                    value <=> Cfg.audio-source;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Kodlayıcı · --audio-encoder");
                Inp {
                    text <=> Cfg.audio-encoder;
                    placeholder: @tr("c2.android.opus.encoder");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
        Row {
            Fld {
                label: @tr("Bit hızı · --audio-bit-rate");
                Inp {
                    text <=> Cfg.audio-bit-rate;
                    placeholder: @tr("128K");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Ara bellek · --audio-buffer (ms)");
                Inp {
                    text <=> Cfg.audio-buffer;
                    placeholder: "50";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Çıkış ara belleği · --audio-output-buffer");
                Inp {
                    text <=> Cfg.audio-output-buffer;
                    placeholder: "5";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
    }

    Hr {}

    ChkGrp {
        Row {
            Chk {
                text: @tr("Sesi kapat · --no-audio");
                checked <=> Cfg.no-audio;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Cihazda da çal · --audio-dup");
                checked <=> Cfg.audio-dup;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Ses başarısızsa çıkış · --require-audio");
                checked <=> Cfg.require-audio;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Sesi oynatma · --no-audio-playback");
                checked <=> Cfg.no-audio-playback;
                toggled => { Cfg.changed(); }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
