// Configuration · Bölüm 01 — Video
//
// Reference section: the other seven are built the same way. Field order,
// labels and placeholders come from design/mockup, and every control writes
// straight into Cfg and then calls Cfg.changed() so the command bar recomputes.

import { Theme } from "../theme.slint";
import { App, Cfg } from "../state.slint";
import { SectionHead, Hr, Fld, Grp, ChkGrp, Inp, Seg, Chk, Btn } from "../components.slint";

export component SectionVideo inherits VerticalLayout {
    spacing: Theme.s4;

    SectionHead {
        kicker: @tr("Bölüm 01");
        title: @tr("Video");
        desc: @tr("Kaynak, kodek ve görüntü boyutu. Kodlayıcı listesi cihazdan --list-encoders ile çekilir; boş bırakılırsa cihazın varsayılanı kullanılır.");
    }

    Hr {}

    Grp {
        Row {
            Fld {
                label: @tr("Kaynak · --video-source");
                Seg {
                    labels: [@tr("Ekran"), @tr("Kamera")];
                    values: ["display", "camera"];
                    value <=> Cfg.video-source;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Kodek · --video-codec");
                Seg {
                    labels: [@tr("h264"), @tr("h265"), @tr("av1")];
                    value <=> Cfg.video-codec;
                    changed => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Kodlayıcı · --video-encoder");
                Inp {
                    text <=> Cfg.video-encoder;
                    placeholder: @tr("c2.android.avc.encoder");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Kodlayıcı listesi");
                Btn {
                    text: @tr("Cihazdan seç · --list-encoders");
                    height: 36px;
                    block: true;
                    clicked => { App.list-encoders(); }
                }
            }
        }
        Row {
            Fld {
                label: @tr("Bit hızı · --video-bit-rate");
                Inp {
                    text <=> Cfg.video-bit-rate;
                    placeholder: @tr("8M");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Azami boyut · --max-size");
                Inp {
                    text <=> Cfg.max-size;
                    placeholder: "1920";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Azami kare · --max-fps");
                Inp {
                    text <=> Cfg.max-fps;
                    placeholder: "60";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
        Row {
            Fld {
                label: @tr("Kırpma · --crop");
                Inp {
                    text <=> Cfg.crop;
                    placeholder: "1224:1440:0:0";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Ekran no · --display-id");
                Inp {
                    text <=> Cfg.display-id;
                    placeholder: "0";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("Ara bellek · --video-buffer (ms)");
                Inp {
                    text <=> Cfg.video-buffer;
                    placeholder: "0";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
    }

    Fld {
        label: @tr("Görüntü yönü · --display-orientation");
        HorizontalLayout {
            alignment: start;
            Seg {
                labels: ["0°", "90°", "180°", "270°", @tr("Aynala")];
                values: ["0", "90", "180", "270", "flip0"];
                value <=> Cfg.display-orientation;
                changed => { Cfg.changed(); }
            }
        }
    }

    Hr {}

    ChkGrp {
        Row {
            Chk {
                text: @tr("Videoyu kapat · --no-video (yalnızca ses/kontrol)");
                checked <=> Cfg.no-video;
                toggled => { Cfg.changed(); }
            }
            Chk {
                text: @tr("Kare sayacını göster · --print-fps");
                checked <=> Cfg.print-fps;
                toggled => { Cfg.changed(); }
            }
        }
        Row {
            Chk {
                text: @tr("Görüntüyü oynatma · --no-video-playback");
                checked <=> Cfg.no-video-playback;
                toggled => { Cfg.changed(); }
            }
            Rectangle {}
        }
    }

    Grp {
        Row {
            // The sink path takes two of the three columns in the mockup.
            Fld {
                colspan: 2;
                label: @tr("V4L2 çıkışı · --v4l2-sink (yalnızca Linux)");
                Inp {
                    text <=> Cfg.v4l2-sink;
                    placeholder: @tr("/dev/video0");
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
            Fld {
                label: @tr("V4L2 ara belleği · --v4l2-buffer (ms)");
                Inp {
                    text <=> Cfg.v4l2-buffer;
                    placeholder: "0";
                    mono: true;
                    edited => { Cfg.changed(); }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
