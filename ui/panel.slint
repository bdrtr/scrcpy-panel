// The scrcpy control panel.
//
// Chrome only: a dark title strip, the tab bar, whichever tab is active, and
// the command bar pinned to the bottom. Everything with content of its own
// lives in ui/tabs/ or ui/config/.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { App, Cfg, Settings, DeviceRow, LogRow, ProfileCard, ShortcutRow, MetricRow } from "state.slint";
import { Btn, Kicker, Mono, Seg } from "components.slint";

import { SectionVideo } from "config/section01_video.slint";
import { SectionAudio } from "config/section02_audio.slint";
import { SectionRecord } from "config/section03_record.slint";
import { SectionControl } from "config/section04_control.slint";
import { SectionVdisplay } from "config/section05_vdisplay.slint";
import { SectionCamera } from "config/section06_camera.slint";
import { SectionWindow } from "config/section07_window.slint";
import { SectionNetwork } from "config/section08_network.slint";

import { TabDevices } from "tabs/devices.slint";
import { TabSession } from "tabs/session.slint";
import { TabProfiles } from "tabs/profiles.slint";
import { TabLog } from "tabs/log.slint";
import { TabShortcuts } from "tabs/shortcuts.slint";
import { TabSettings } from "tabs/settings.slint";

/// One row in the configuration tab's section list.
component SectionLink inherits Rectangle {
    in property <string> text;
    in property <string> key;

    property <bool> active: App.section == root.key;

    height: 40px;
    background: root.active
        ? Theme.accent
        : touch.has-hover ? Theme.wash-7 : transparent;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }

    Text {
        x: Theme.s4;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-size: 14px;
        color: root.active ? Theme.bg : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.section = root.key; }
    }
}

export component PanelWindow inherits Window {
    title: @tr("scrcpy panel");
    background: Theme.bg;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    default-font-family: Theme.font;
    default-font-size: 14px;

    VerticalLayout {
        // ── Title strip ──────────────────────────────────────────────
        Rectangle {
            height: 36px;
            background: Theme.neutral-900;

            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s3;

                HorizontalLayout {
                    spacing: 7px;
                    alignment: center;
                    Rectangle { width: 11px; height: 11px; background: Theme.accent; }
                    Rectangle { width: 11px; height: 11px; background: Theme.neutral-600; }
                    Rectangle { width: 11px; height: 11px; background: Theme.neutral-700; }
                }

                Text {
                    text: @tr("SCRCPY PANEL");
                    font-size: 12px;
                    font-weight: Theme.heading-weight;
                    letter-spacing: 1.9px;
                    color: Theme.neutral-100;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("Slint · Rust · scrcpy ") + Settings.server-version;
                    font-size: 11px;
                    color: Theme.neutral-500;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: App.adb-status;
                    font-family: Theme.mono;
                    font-size: 11px;
                    color: Theme.neutral-500;
                    vertical-alignment: center;
                }
            }
        }

        // ── Tab bar ──────────────────────────────────────────────────
        Rectangle {
            height: 58px;
            background: Theme.bg;

            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.divider;
            }

            HorizontalLayout {
                padding: Theme.s3;
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                spacing: Theme.s4;

                Seg {
                    labels: [@tr("Cihazlar"), @tr("Yapılandırma"), @tr("Oturum"), @tr("Profiller"), @tr("Günlük"), @tr("Kısayollar"), @tr("Ayarlar")];
                    values: ["devices", "config", "session", "profiles", "log", "keys", "settings"];
                    value <=> App.tab;
                }

                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: Theme.s2;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        background: App.session-running ? Theme.accent : Theme.neutral-400;
                    }
                    Text {
                        text: App.selection-label;
                        font-family: Theme.mono;
                        font-size: 12px;
                        color: Theme.neutral-700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Active tab ───────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if App.tab == "devices": TabDevices {}
            if App.tab == "session": TabSession {}
            if App.tab == "profiles": TabProfiles {}
            if App.tab == "log": TabLog {}
            if App.tab == "keys": TabShortcuts {}
            if App.tab == "settings": TabSettings {}

            if App.tab == "config": HorizontalLayout {
                // Section list
                Rectangle {
                    width: 216px;

                    Rectangle {
                        x: parent.width - 2px;
                        width: 2px;
                        background: Theme.divider;
                    }

                    VerticalLayout {
                        Text {
                            text: @tr("BÖLÜMLER");
                            font-size: 10px;
                            letter-spacing: 1.2px;
                            color: Theme.accent;
                            horizontal-alignment: left;
                        }

                        SectionLink { text: @tr("01 · Video"); key: "video"; }
                        SectionLink { text: @tr("02 · Ses"); key: "audio"; }
                        SectionLink { text: @tr("03 · Kayıt"); key: "record"; }
                        SectionLink { text: @tr("04 · Kontrol ve giriş"); key: "control"; }
                        SectionLink { text: @tr("05 · Sanal ekran"); key: "vdisplay"; }
                        SectionLink { text: @tr("06 · Kamera"); key: "camera"; }
                        SectionLink { text: @tr("07 · Pencere ve ekran"); key: "window"; }
                        SectionLink { text: @tr("08 · Ağ ve ADB"); key: "network"; }

                        Rectangle { vertical-stretch: 1; }

                        // Summary footer
                        VerticalLayout {
                            padding: Theme.s4;
                            spacing: Theme.s2;
                            Kicker { text: @tr("ÖZET"); }
                            Text {
                                text: App.flag-count + @tr(" bayrak etkin");
                                font-size: 12px;
                                color: Theme.neutral-700;
                            }
                            Btn {
                                text: @tr("Varsayılanlara dön");
                                block: true;
                                clicked => { App.reset-defaults(); }
                            }
                        }
                    }
                }

                // Section body
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.s6;
                        // A section is a stack of rows at their own height, not
                        // a thing to spread over whatever height it is given.
                        // Without this the slack in a window taller than the
                        // form goes into the grid rows, and a field drifts 90px
                        // below the label that names it.
                        alignment: start;

                        if App.section == "video": SectionVideo {}
                        if App.section == "audio": SectionAudio {}
                        if App.section == "record": SectionRecord {}
                        if App.section == "control": SectionControl {}
                        if App.section == "vdisplay": SectionVdisplay {}
                        if App.section == "camera": SectionCamera {}
                        if App.section == "window": SectionWindow {}
                        if App.section == "network": SectionNetwork {}
                    }
                }
            }
        }

        // ── Command bar ──────────────────────────────────────────────
        if App.command-open: Rectangle {
            height: 84px;
            background: Theme.surface;

            Rectangle { y: 0; height: 2px; background: Theme.divider; }

            VerticalLayout {
                padding: Theme.s3;
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                spacing: Theme.s2;

                HorizontalLayout {
                    spacing: Theme.s3;
                    Kicker { text: @tr("OLUŞAN KOMUT"); }
                    Text {
                        text: App.flag-count + @tr(" bayrak");
                        font-size: 11px;
                        color: Theme.text-50;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: @tr("Kopyala");
                        kind: "ghost";
                        clicked => { App.copy-command(); }
                    }
                }

                Mono {
                    text: App.command;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }

        Rectangle {
            height: 56px;
            background: Theme.bg;

            Rectangle { y: 0; height: 2px; background: Theme.divider; }

            HorizontalLayout {
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                spacing: Theme.s2;

                Text {
                    text: App.status-line;
                    font-family: Theme.mono;
                    font-size: 12px;
                    color: Theme.neutral-700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { horizontal-stretch: 1; }

                Btn {
                    text: App.command-open ? @tr("Komutu gizle") : @tr("Komutu göster");
                    y: (parent.height - self.height) / 2;
                    clicked => { App.command-open = !App.command-open; }
                }
                Btn {
                    text: @tr("Profil olarak kaydet");
                    y: (parent.height - self.height) / 2;
                    clicked => { App.save-profile(); }
                }
                Btn {
                    text: App.session-running
                        ? @tr("Oturumu durdur")
                        : App.selected-count > 1
                            ? App.selected-count + @tr(" cihazda başlat")
                            : @tr("Ayarlarınla başlat");
                    kind: "primary";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        if (App.session-running) {
                            App.stop-session();
                        } else {
                            App.start-session();
                        }
                    }
                }
            }
        }
    }
}
