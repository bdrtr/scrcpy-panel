// The standalone mirror window.
//
// A frame around MirrorView and nothing else: the picture, its state and its
// input all live in the Mirror global, which is also what the panel binds when
// it hosts the same view inside its session tab.

import { Mirror, MirrorView } from "mirror_view.slint";

export component MirrorWindow inherits Window {
    in property <string> window-title: @tr("scrcpy-panel");
    /// --borderless. This is Slint's own property rather than anything done to
    /// the winit window: the adapter re-applies decorations from `no-frame`
    /// every time it updates window properties, so a decoration set any other
    /// way is overwritten moments later.
    in property <bool> borderless;
    in property <string> status;
    in property <bool> status-visible: false;

    title: root.window-title;
    no-frame: root.borderless;
    background: Mirror.backdrop;
    preferred-width: 420px;
    preferred-height: 860px;
    min-width: 160px;
    min-height: 160px;
    forward-focus: view;

    view := MirrorView {
        width: 100%;
        height: 100%;
    }

    if root.status-visible: Rectangle {
        x: 12px;
        y: 12px;
        width: label.width + 16px;
        height: label.height + 8px;
        background: #000000cc;
        border-radius: 3px;

        label := Text {
            x: 8px;
            y: 4px;
            text: root.status;
            color: #f2efe9;
            font-size: 12px;
        }
    }
}
